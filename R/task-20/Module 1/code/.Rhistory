head(stays$gender)
ggplot(stays, aes(gender)) +
geom_bar()
stays %>%
count(gender)
stays %>%
count(gender)%>%
ggplot(.,aes(x=gender, y=n)) + geom_bar()
stays %>%
count(gender)%>%
ggplot(.,aes(x=gender, y=n)) + geom_col()
ggplot(stays, aes(x = admit_type))+
geom_bar()
ggplot(stays, aes(x = discharge_department))+
geom_bar()
ggplot(stays, aes(y = discharge_department))+
geom_bar()
stays %>%
count(gender)%>%
ggplot(.,aes(x=gender, y=n)) + geom_bar(stat='identity')
