  X = state_soil(MU,LANDA,q,P2)
  
  X[1]=0
  X[2]=0
  X[3]=0
  
  
  for (i in 4:length(Precip)) {
    if (X[i]*SF>TX){
      X[i]=X[i]
    } else {
      X[i]=0
    }
  }
  
  q = effective_rainfall(Precip, PET)
  
  X = state_soil(MU,LANDA,q,P2)
  X[1]=0
  X[2]=0
  X[3]=0
  
  Qsim<-rep(NA, 366)
  
