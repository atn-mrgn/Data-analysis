  for (i in 3:length(Precip)) {
    Qsim[i]=Qsim[i-1]-MU/LANDA*(Qsim[i-1])^(2*MU-1)+X[i]*q[i-1]/LANDA
    
    if (Qsim[i]<=0){
      Qsim[i]=0
    } else {
      Qsim[i]=Qsim[i]
    }
  }
  
  return(Qsim)
