effective_rainfall <- function(Precip,PET){
  q<-rep(NA, 366)
  n=length(Precip)
  for (i in 1:n) {
    if(Precip[i]-PET[i]>0){
      q[i]=Precip[i]-PET[i]
    }
    else{
      q[i]=0
    }
  }
  return(q)
}
