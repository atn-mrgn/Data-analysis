## Visualization theme
```{r}
library(showtext)

# do this for any font you want to use
font_add_google("Poppins", db_cache = FALSE)
# do this for any font you want to use
font_add_google("Nunito", db_cache = FALSE)

showtext_auto()

my_theme <- theme_minimal() +  # start with closest built-in (uses theme_gray() if not specified), 
  # then override specific settings
  theme(text = element_text("Poppins", size=18),
        plot.title.position = "panel",
        panel.grid.minor = element_blank(),
        axis.title.x = element_text(margin = margin(t=10)),
        axis.title.y = element_text(margin = margin(r=10)),
        plot.title = element_text(size = 20, face = "bold"),
        #panel.grid.major.y = element_blank(),
        panel.grid.major.x = element_line(linewidth = 0.5, color = "gray"),
        legend.position = "bottom",
        axis.text.x=element_text(),
        axis.ticks.x=element_blank(),
        plot.margin = margin(r=0.5, unit="cm"))
```

## Visualization 1

```{r}
df1<-flights %>%
  group_by(dest) %>%
  summarise(mean_arr_delay=mean(arr_delay, na.rm = TRUE),
            mean_dep_delay=mean(dep_delay, na.rm = TRUE)) %>%
  filter(dest %in% c("PDX", "LNK", "JAC", "SAT", "MIA"))

df2<-airports %>%
  filter(faa %in% c("PDX", "LNK", "JAC", "SAT", "MIA")) %>%
  select(dest="faa","name","lat","lon")

df <- left_join(df1, df2, by="dest")

ggplot(stat = "identity") + 
  geom_polygon(data=s, 
               aes(x=long, y=lat,group=group, fill=group)) + 
  geom_point(data = df,
             aes(x = lon, y = lat, group=dest),
             color = "red", size=2) +
  geom_text(data=df, aes(x=lon, y=lat, group=dest, label=paste("Arr_Del :",round(mean_arr_delay,2),"\n","Dep_del :",round(mean_dep_delay,2))), vjust=-0.25, size=4, color="red")+
  coord_map("polyconic")+
  labs(
    title = "U.S. airport flight delays",
    subtitle = "Mean arrival and departure delays in some states",
    x=NULL,
    y=NULL
  )+
  my_theme+
  theme(legend.position = "none",
        axis.text = element_blank(),
        axis.ticks = element_blank())
```


