# Set the default chunk options for the file
# You can override these for individual chunks if needed
knitr::opts_chunk$set(echo = FALSE,   # include the code chunks in the output file
warning = FALSE,  # do not include any warning messages in the output file
message = FALSE,  # do not include any general messages in the output file
fig.width=7, fig.height=4)  # default figure/plot sizes
library(tidyverse)
library(nycflights13)
library(maps)
library(mapproj)
library(readxl)
library(janitor)
library(grid)
library(RColorBrewer)
national %>%
distinct(occ_title, .keep_all = TRUE) %>%
filter(str_detect(occ_code,"29-|31-"),!(tot_emp=="**"), !(a_mean %in% c("*","#"))) %>%
mutate(
a_mean=as.numeric(a_mean),
tot_emp=as.numeric(tot_emp)
)%>%
arrange(desc(tot_emp)) %>%
mutate(prop=round(tot_emp*100/sum(tot_emp))) %>%
slice(1:5) %>%
ggplot(aes(x=prop, y=reorder(occ_title,prop)))+
geom_col()+
annotate("segment", y=0.5, yend=5.7, x=15, xend = 15, color="darkred", linewidth=1, alpha=0)+
geom_text(aes(label=paste(prop,"%")), hjust=1., size=5, color="white", face=rep(c("bold"))) +
labs(title="Occupations with the most estimated employment",
subtitle="Top 5 by proportion of estimated employment in 2021",
y="Occupations",
x=NULL) +
theme_minimal() +
# remove legend
theme(axis.text.x = element_blank(),
#axis.text = element_text(size=11.5),
# remove tick marks
axis.ticks.x = element_blank(),
# remove major horizontal grids
panel.grid.major.y = element_blank(),
# remove both minor grids
panel.grid.minor = element_blank(),
axis.text=element_text(size=11.5, face=rep(c("bold"))))
