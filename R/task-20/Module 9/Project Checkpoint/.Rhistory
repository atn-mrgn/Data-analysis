national %>%
distinct(occ_title, .keep_all = TRUE) %>%
filter(str_detect(occ_code,"29-|31-"),!(tot_emp=="**"), !(a_mean %in% c("*","#"))) %>%
mutate(
a_mean=as.numeric(a_mean),
tot_emp=as.numeric(tot_emp)
)%>%
arrange(desc(tot_emp)) %>%
mutate(prop=round(tot_emp*100/sum(tot_emp)),
highlight=as.numeric(a_mean)>mean_wage) %>%
slice(1:5) %>%
ggplot(aes(x=reorder(occ_title,prop), y=as.numeric(a_mean), fill=highlight))+
geom_text(aes(label=as.numeric(a_mean)), hjust=0, size=3.5)+
annotate("segment", x=0, xend=6, y=67382.66, yend = 67382.66)+
annotate("segment", y = 67500, yend = 67383, x = 1.5, xend = 1.5,
size = 1.5, arrow = arrow(length = unit(.25,"cm")))+
annotate( "text", y=67450, x=1.5, label="Mean Wage in U.S.",hjust=-0.2, size=4)+
geom_col()+
coord_flip()+
scale_fill_manual(values=c("gray30", "darkred")) +
labs(title="Annual Wage",
subtitle="Mean annual wage in top 5 occupations",
y=NULL,
x="Occupations") +
theme_minimal() +
# remove legend
theme(axis.text.x = element_blank(),
# remove legend
legend.position = "none",
# remove tick marks
axis.ticks.x = element_blank(),
# remove both minor grids
panel.grid.minor = element_blank())
national %>%
distinct(occ_title, .keep_all = TRUE) %>%
mutate(mean_wage=mean(as.numeric(a_mean), na.rm = TRUE))%>%
filter(str_detect(occ_code,"29-|31-"),!(tot_emp=="**"), !(a_mean %in% c("*","#"))) %>%
mutate(
a_mean=as.numeric(a_mean),
tot_emp=as.numeric(tot_emp)
)%>%
arrange(desc(tot_emp)) %>%
mutate(prop=round(tot_emp*100/sum(tot_emp)),
highlight=as.numeric(a_mean)>mean_wage) %>%
slice(1:5) %>%
ggplot(aes(x=reorder(occ_title,prop), y=as.numeric(a_mean), fill=highlight))+
geom_text(aes(label=as.numeric(a_mean)), hjust=0, size=3.5)+
annotate("segment", x=0, xend=6, y=67382.66, yend = 67382.66)+
annotate("segment", y = 67500, yend = 67383, x = 1.5, xend = 1.5,
size = 1.5, arrow = arrow(length = unit(.25,"cm")))+
annotate( "text", y=67450, x=1.5, label="Mean Wage in U.S.",hjust=-0.2, size=4)+
geom_col()+
coord_flip()+
scale_fill_manual(values=c("gray30", "darkred")) +
labs(title="Annual Wage",
subtitle="Mean annual wage in top 5 occupations",
y=NULL,
x="Occupations") +
theme_minimal() +
# remove legend
theme(axis.text.x = element_blank(),
# remove legend
legend.position = "none",
# remove tick marks
axis.ticks.x = element_blank(),
# remove both minor grids
panel.grid.minor = element_blank())
