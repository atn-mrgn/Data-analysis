```{r}
library(tidyverse)
library(readxl)
library(janitor)
library(grid)
```

#### Load dataset
```{r}
national <- read_excel("national_M2021_dl.xlsx") %>% clean_names()
state <- read_excel("state_M2021_dl.xlsx") %>% clean_names()
```


## Visualization 1
```{r, fig.width=8, fig.height=4}
national %>% 
  distinct(occ_title, .keep_all = TRUE) %>%
  filter(!(tot_emp=="**"), !(a_mean %in% c("*","#"))) %>%
  ggplot(aes(y=as.numeric(tot_emp), x=as.numeric(a_mean)))+
  geom_bin2d()+
  scale_fill_viridis_c(option = "D")+
  labs(
    title = "Number of employment by mean annual wage",
    x="Mean Annual Wage",
    y="Total Employment"
  )
```


## Visualization 2
```{r}
state %>% 
  distinct(occ_title, .keep_all = TRUE) %>%
  filter(str_detect(occ_code,"29-"),!(tot_emp=="**"), !(a_mean %in% c("*","#"))) %>%
  ggplot(aes(y=as.numeric(tot_emp), x=as.numeric(a_mean)))+
  geom_point(aes(color=area_title),size=2)+
  scale_colour_brewer(palette = "Dark2")+
  labs(
    title = "Number of employment by mean annual wage",
    subtitle = "in Healthcare Occupations",
    x="Mean Annual Wage",
    y="Total Employment"
  )
```


## Visualisation 3
```{r, fig.width=8, fig.height=4}
library(showtext)

# two additional steps needed

# do this for any font you want to use
font_add_google("Poppins", db_cache = FALSE)

# do this just once in a file to start using this package for fonts
showtext_auto()

state %>% 
  distinct(occ_title, .keep_all = TRUE) %>%
  filter(str_detect(occ_code,"29-"),!(tot_emp=="**"), !(a_mean %in% c("*","#"))) %>%
  ggplot(aes(y=as.numeric(tot_emp), x=as.numeric(a_mean)))+
  geom_point(aes(color=area_title),size=3, alpha=0.5)+
  scale_colour_brewer(palette = "Dark2")+
  labs(
    title = "Number of employment by mean annual wage",
    subtitle = "in Healthcare Occupations",
    x="Mean Annual Wage",
    y="Total Employment"
  )+
  scale_x_continuous(labels=scales::dollar)+
  scale_y_continuous(labels=scales::comma)+
  theme(
    text = element_text("Poppins", size=18),
    axis.ticks = element_blank(),
    #panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    axis.title.x = element_text(margin = margin(t=10)),
    axis.title.y = element_text(margin = margin(r=10)),
    plot.title = element_text(size = 20, face = "bold"),
    axis.text.y = element_text(margin = margin(r=1)),
    #legend.direction = "horizontal",
    legend.spacing.x = unit(0.2, 'cm'),
    legend.position = c(0.9,0.8),
    legend.title = element_blank(),
    plot.margin = margin(r=0.5, unit="cm"),
    legend.background = element_blank(),
    #panel.background = element_blank(),
    #plot.background = element_rect(fill = "gray90")
  )
```

