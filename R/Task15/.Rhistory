View(data)
likelihood <- function(mu, data) {
prod(dnorm(data, mean = mu, sd = sd(data)))
}
posterior_unnormalized <- function(mu, prior_mean, prior_variance, data) {
likelihood(mu, data) * dnorm(mu, mean = prior_mean, sd = sqrt(prior_variance))
}
laplace_approximation <- function(data, prior_mean, prior_variance) {
mode <- optimize(function(mu) posterior_unnormalized(mu, prior_mean, prior_variance, data),
lower = -10, upper = 10, maximum = TRUE)$maximum
curvature <- -optim(mode, fn = function(mu) -posterior_unnormalized(mu, prior_mean, prior_variance, data),
method = "BFGS", hessian = TRUE)$hessian
variance <- 1 / curvature
return(c(mode, variance))
}
prior_mean <- 0
prior_variance <- 1
ERROR_laplace <- laplace_approximation(data$ERROR, prior_mean, prior_variance)
ERROR_mean <- ERROR_laplace[1]
ERROR_variance <- ERROR_laplace[2]
mse <- mean((data$ERROR - ERROR_mean)^2)
bias <- mean(data$ERROR - ERROR_mean)
# Afficher les résultats
cat("MSE:", mse, "\n")
cat("Bias:", bias, "\n")
mse <- mean((data$ERROR - ERROR_mean)^2)
bias <- mean(data$ERROR - ERROR_mean)
# Afficher les résultats
cat("MSE (ERROR):", mse, "\n")
cat("Bias (ERROR):", bias, "\n")
# Test du ratio de vraisemblance
log_likelihood_null <- sum(dnorm(data$ERROR, mean = mean(data$ERROR), sd = sd(data$ERROR), log = TRUE))
log_likelihood_alternative <- sum(dnorm(data$ERROR, mean = ERROR_mean, sd = sqrt(ERROR_variance), log = TRUE))
lrt <- -2 * (log_likelihood_null - log_likelihood_alternative)
p_value_lrt <- pchisq(lrt, df = 1, lower.tail = FALSE)
# Test de Wald
wald <- (ERROR_mean - mean(data$ERROR))^2 / ERROR_variance
p_value_wald <- pchisq(wald, df = 1, lower.tail = FALSE)
# Afficher les résultats
cat("Likelihood Ratio Test statistic:", lrt, "\n")
cat("p-value for LRT:", p_value_lrt, "\n")
cat("Wald Test statistic:", wald, "\n")
cat("p-value for Wald Test:", p_value_wald, "\n")
