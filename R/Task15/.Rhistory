section_counts <- table(data$Section)
prob_vector <- rep(1/4, length(section_counts))
log_likelihood_null_section <- sum(dmultinom(section_counts, prob = prob_vector, log = TRUE))
log_likelihood_alternative <- sum(logLik(section_model))
lrt_section <- 2 * (log_likelihood_null - log_likelihood_alternative)
p_value_lrt_section <- pchisq(lrt_section, df = length(coef(section_model)), lower.tail = FALSE)
cat("Likelihood Ratio Test statistic (section):", lrt_section, "\n")
cat("p-value for LRT (section):", p_value_lrt_section, "\n")
direction_counts <- table(data$Direction)
prob_vector <- rep(1/4, length(direction_counts))
log_likelihood_null_section <- sum(dmultinom(direction_counts, prob = prob_vector, log = TRUE))
log_likelihood_alternative <- sum(logLik(direction_model))
lrt_direction <- -2 * (log_likelihood_null - log_likelihood_alternative)
p_value_lrt_direction <- pchisq(lrt_direction, df = length(coef(direction_model)), lower.tail = FALSE)
cat("Likelihood Ratio Test statistic (direction):", lrt_direction, "\n")
cat("p-value for LRT (direction):", p_value_lrt_direction, "\n")
