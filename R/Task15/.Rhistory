# Calcul du test de Wald pour 'direction'
wald_statistic <- function(params, se) {
wald <- (params / se)^2
p_value <- pchisq(wald, df = 1, lower.tail = FALSE)
return(data.frame(wald = wald, p_value = p_value))
}
wald_results <- wald_statistic(params, se)
# Afficher les résultats pour 'direction'
cat("Wald Test statistic (direction):", sum(wald_results$wald), "\n")
cat("p-value for Wald Test (direction):", sum(wald_results$p_value), "\n")
